@model EntityLayer.Concrete.Reservation
@{
    ViewData["Title"] = "NewReservation";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Yeni Rezervasyon Yap</h4>
                <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                <div class="heading-elements">
                    <ul class="list-inline mb-0">
                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                        <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        <li><a data-action="close"><i class="ft-x"></i></a></li>
                    </ul>
                </div>
            </div>
            <div class="card-content collapse show">
                <div class="card-body">
                    <p class="card-text">Web Sitemiz Traversal üzerinde yer alan lokasyonlar içinde yeni bir rezervasyonu aşağıdaki panelden yapabilirsiniz.</p>
                    <div class="table-responsive">
                        <form method="post">
                            <div class="form-group">
                                @Html.Label("Lokasyon Seçin")
                                @Html.DropDownListFor(x => x.DestinationId, (List<SelectListItem>)ViewBag.DestinationList, "Lütfen bir şehir seçin...", new { @class = "form-control" })
                            </div>

                            <div class="form-group">
                                @Html.Label("Kişi Sayısı")
                                <input type="number" asp-for="PersonCount" class="form-control" min="1" max="10" />
                            </div>

                            <div class="form-group">
                                @Html.Label("Rezervasyon Tarihi")
                                <input type="date" asp-for="ReservationDate" class="form-control" />
                            </div>

                            <div class="form-group">
                                @Html.Label("Eklemek İstedikleriniz (Notlar)")
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg">Rezervasyonu Tamamla</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


