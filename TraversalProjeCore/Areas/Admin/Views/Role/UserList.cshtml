@model List<AppUser>
@{
    ViewData["Title"] = "UserList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Kullanıcı Listesi</h1>

<table class="table table-bordered">
    <tr>
        <th>Kullanıcı Adı</th>
        <th>Rol Ata</th>
    </tr>

    @foreach (var x in Model)
    {
        <tr>
            <td>@x.UserName</td>
            <td><a href="/Admin/Role/AssignRole/@x.Id" class="btn btn-outline-warning">Rol Ata</a></td>
        </tr>
    }
</table>