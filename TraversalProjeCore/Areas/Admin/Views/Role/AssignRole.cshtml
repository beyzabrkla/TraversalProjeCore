@model List<TraversalProjeCore.Areas.Admin.Models.RoleAssignViewModel>
@{
    ViewData["Title"] = "Rol Atama";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <h5 class="card-header">Kullanıcı Rol Atama Sayfası</h5>
    <div class="card-body">
        <form method="post">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="form-check mb-3">
                    <input type="hidden" asp-for="@Model[i].RoleId" />
                    <input type="hidden" asp-for="@Model[i].RoleName" />

                    <input type="checkbox" asp-for="@Model[i].RoleExist" class="form-check-input" id="role_@i" />
                    <label class="form-check-label" for="role_@i">
                        @Model[i].RoleName
                    </label>
                </div>
            }
            <br />
            <button class="btn btn-primary">Değişiklikleri Kaydet</button>
            <a href="/Admin/Role/UserList" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>