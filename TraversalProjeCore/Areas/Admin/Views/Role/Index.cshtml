@model List<AppRole>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<h1>Rol Listesi</h1>
@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Rol Adı</th>
            <th>Rolü Sil</th>
            <th>Rolü Güncelle</th>
        </tr>


        @foreach (var x in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@x.Name</td>
                <td><a href="/Admin/Role/DeleteRole/@x.Id" class="btn btn-outline-danger">Rolü Sil</a></td>
                <td><a href="/Admin/Role/UpdateRole/@x.Id" class="btn btn-outline-primary">Rolü Güncelle</a></td>
            </tr>
        }
    </table>
}

else
{
    <tr>
        <td class="alert-danger">Herhangi bir Rol bulunamadı.</td>
    </tr>

}
<a href="/Admin/Role/CreateRole" class="btn btn-outline-success">Yeni Rol Girişi</a>
