@using EntityLayer.Concrete
@model List<Guide>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<h1>Rehber Listesi</h1>
<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Ad Soyad</th>
        <th>Açıklama</th>
        <th>Durum</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var x in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td><img src="@x.Image" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" /></td>
            <td>@x.Name</td>
            <td>@x.Description</td>
            @if (x.Status == true)
            {
                <td><a href="/Admin/Guide/ChangeToFalse/@x.GuideId" class="btn btn-outline-warning">Pasif Yap</a></td>
            }
            else
            {
                <td><a href="/Admin/Guide/ChangeToTrue/@x.GuideId" class="btn btn-outline-success">Aktif Yap</a></td>
            }

            <td>
                <a href="/Admin/Guide/EditGuide/@x.GuideId" class="btn btn-outline-warning">Düzenle</a>
                <form method="post" action="/Admin/Guide/DeleteGuide/@x.GuideId" style="display:inline;">
                    <button type="submit"
                            class="btn btn-outline-danger"
                            onclick="return confirm('Bu rehberi silmek istediğinizden emin misiniz?');">
                        Sil
                    </button>
                </form>
            </td>
        </tr>
    }
</table>
<a href="/Admin/Guide/AddGuide/" class="btn btn-outline-primary">Yeni Rehber Giriş</a>
