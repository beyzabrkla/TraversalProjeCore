@using EntityLayer.Concrete
@model List<Comment>
@{
    ViewData["Title"] = "CommentUser";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <h5 class="card-header">Kullanıcı Yorum Listesi</h5>
    <div class="table-responsive text-nowrap">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kullanıcı</th>
                    <th>Rota/Şehir</th>
                    <th>Tarih</th>
                    <th>İçerik</th>
                    <th>Sil</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.CommentId</td>
                        <td>@x.CommentUser</td>
                        <td>@x.Destination.City</td>
                        <td>@(((DateTime)x.CommentDate).ToString("dd-MMM-yyyy"))</td>
                        <td>@x.CommentContent</td>
                        <td>
                            <a href="/Admin/Comment/DeleteComment/@x.CommentId" class="btn btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">Bu kullanıcıya ait henüz bir yorum bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>