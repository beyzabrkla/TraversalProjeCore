@using EntityLayer.Concrete
@model List<Reservation>
@{
    ViewData["Title"] = "ReservationUser";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<h1>Kullanıcının Geçmiş Rezervasyonları</h1>

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Misafir Ad Soyad</th>
        <th>Rota</th>
        <th>Kişi Sayısı</th>
        <th>Tarih</th>
        <th>Detaylar</th>
    </tr>
    @foreach (var x in Model)
    {
        {count +=1;}

        <tr>
            <td>@count</td>
            <td>###</td>
            <td>@x.Destination.City</td>
            <td>@x.PersonCount</td>
            <td>@(((DateTime)x.ReservationDate).ToString("dd-MMM-yyy"))</td>
            <td><a href="#" class="btn btn-outline-primary">Detaylar</a></td>
        </tr>
    }
</table>

<a class="btn btn-outline-primary" href="/Login/SignUp">Yeni Kullanıcı Kaydı</a>