@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en" class="light-style layout-menu-fixed" dir="ltr" data-theme="theme-default">
<body>
    
    @await Component.InvokeAsync("AdminDashboardHeader")

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-lg-8 mb-4 order-0">
            @await Component.InvokeAsync("DashboardBanner")
        </div>
        <div class="col-lg-4 col-md-4 order-1">
            @await Component.InvokeAsync("Cards1Statistic")
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            @await Component.InvokeAsync("TotalRevenue")
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            @await Component.InvokeAsync("DestinationStatistics")
        </div>
        <div class="col-md-6 mb-4">
            @await Component.InvokeAsync("AdminLastMessages")
        </div>
    </div>
</div>
    <div class="content-backdrop fade"></div>

</body>
</html>