@model List<BookingHotelSearchViewModel.Result>
@{
    ViewData["Title"] = "GetCityDestId";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Booking Oteller İçin Şehir ID Bilgisi Getirme</h2>
<br />

<form asp-action="GetCityDestId" asp-controller="BookingHotelSearch" asp-area="Admin" method="post">
    <label>Şehir Adını Giriniz:</label>
    <input type="text" class="form-control" name="p" required />
    <br>
    <button class="btn btn-outline-primary">Şehir ID Getir</button>
</form>
