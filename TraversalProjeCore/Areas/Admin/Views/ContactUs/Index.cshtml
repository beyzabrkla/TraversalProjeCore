@model List<ContactUs>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<h1>Bize Ulaşın Mesaj Listesi</h1>

<table class="table table-bordered" >
    <tr>
        <th>#</th>
        <th>Gönderen</th>
        <th>Konu</th>
        <th>Tarih</th>
        <th>Detay</th>
        <th>Sil</th>
    </tr>
    @foreach (var x in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@x.Name</td>
            <td>@x.Subject</td>
            <td>@x.MessageDate.ToString("dd-MMM-yyyy")</td>
            <td><a href="/Admin/ContactUs/ContactUsDetails/@x.ContactUsId" class="btn btn-outline-primary">Mesajı Aç</a></td>
            <td><a href="/Admin/ContactUs/DeleteContactUs/@x.ContactUsId" class="btn btn-outline-danger" onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?')">Mesajı Sil</a></td>
        </tr>
    }
</table>