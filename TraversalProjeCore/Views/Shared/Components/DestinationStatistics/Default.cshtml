@using EntityLayer.Concrete
@model List<Destination>

    <div class="card h-100">
        <div class="card-header d-flex align-items-center justify-content-between pb-0">
            <div class="card-title mb-0">
                <h5 class="m-0 me-2">Rota İstatistikleri</h5>
                <small class="text-muted">@ViewBag.v1 Toplam Satış</small>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex flex-column align-items-center gap-1">
                    <h2 class="mb-2">@ViewBag.v2</h2>
                    <span>Toplam Rota</span>
                </div>
                <div id="orderStatisticsChart"></div>
            </div>
            <ul class="p-0 m-0">
                @if (Model != null)
                {
                    @foreach (var item in Model.Take(4)) // Sadece ilk 4 tanesini gösterelim
                    {
                        <li class="d-flex mb-4 pb-1">
                            <div class="avatar flex-shrink-0 me-3">
                                <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-map"></i></span>
                            </div>
                            <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                                <div class="me-2">
                                    <h6 class="mb-0">@item.City</h6>
                                    <small class="text-muted">@item.DayNight Gece/Gündüz</small>
                                </div>
                                <div class="user-progress">
                                    <small class="fw-semibold">@item.Price ₺</small>
                                </div>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
