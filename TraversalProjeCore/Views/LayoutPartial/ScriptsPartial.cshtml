<script>
    (function($) {
        if (typeof $.fn.load !== 'function') {
            $.fn.load = function(callback) {
                return this.on('load', callback);
            };
        }
    })(jQuery);
</script>
<script src="/Traversal-Starter/assets/js/owl.carousel.js"></script>
<script src="/Traversal-Starter/assets/js/jquery.zoomslider.min.js"></script>
<script src="/Traversal-Starter/assets/js/theme-change.js"></script>
