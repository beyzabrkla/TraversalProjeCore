<script>
    $(document).ready(function () {
        $('.counter').countUp();

        // Eğer hala otomatik kaymıyorsa bu satırı ekle:
        if ($.fn.zoomSlider) {
            $("#demo-1").zoomSlider();
        }
    });
</script>
<script>
    $(document).ready(function () {
      $('.owl-two').owlCarousel({
        loop: true,
        margin: 20,
        nav: false,
        responsiveClass: true,
        autoplay: true,        // Kendiliğinden değişmesi için
        autoplayTimeout: 5000,
        autoplaySpeed: 1000,
        responsive: {
          0: {
            items: 1,          // Mobilde 1 tane
            nav: false
          },
          480: {
            items: 1,          // Orta ekranda 1 tane
            nav: false
          },
          1000: {
            items: 1,          // Masaüstünde 1 tane (Senin istediğin değişiklik burası)
            nav: false
          }
        }
      })
    });
</script>