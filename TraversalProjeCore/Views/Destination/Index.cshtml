@model List<Destination>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
<body>
    <!-- about breadcrumb -->
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">Rotalar </h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Default/Index">Ana Sayfa</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Rotalar </li>
                </ul>
            </div>
        </div>
    </section>
    <!-- //about breadcrumb -->
    <!--  Work gallery section -->
    <section class="grids-1 py-5">
        <div class="grids py-lg-5 py-md-4">
            <div class="container">
                <h3 class="hny-title mb-5">Tur Rotaları</h3>
                <div class="row">
                    @foreach (var x in Model)
                    {
                        <div class="col-lg-4 col-md-6 col-6 mb-4">
                            <div class="rota-kart-yeni">
                                <div class="rota-resim">
                                    <a href="/Destination/DestinationDetails/@x.DestinationId">
                                        <img src="@x.Image" alt="" class="img-fluid">
                                    </a>
                                </div>
                                <div class="rota-icerik">
                                    <h4><a href="/Destination/DestinationDetails/@x.DestinationId">@x.City</a></h4>
                                    <p>@x.DayNight</p>
                                    <div class="dst-btm">
                                        <h6>Başlayan Fiyatlarla</h6>
                                        <span>@x.Price ₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</body>   
<link href="~/Traversal-Starter/assets/css/style-starter.css" rel="stylesheet" />
<script src="~/Traversal-Starter/assets/js/bootstrap.min.js"></script>