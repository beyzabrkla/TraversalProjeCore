@model EntityLayer.Concrete.Destination
@{
    ViewData["Title"] = "DestinationDetails";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<!doctype html>
<html lang="zxx">

<body>
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">Tur Detayları</h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Default/Index">Ana Sayfa</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Rota Detayları </li>
                </ul>
            </div>
        </div>
    </section>

    <div class="py-5 w3l-homeblock1 text-center">
        <div class="container mt-md-3">
            <h3 class="blog-desc-big text-center mb-4">
                Alanında en yetkin rehberlerimizin en güncel seyahat hikayelerini okumalısınız !!
            </h3>
            <div class="blog-post-align">
                <div class="blog-post-img">
                    <a href="#"><img src="@Model.Guide.Image" alt="" class="rounded-circle img-fluid" style="width:80px; height:80px; object-fit:cover;" /></a>
                </div>
                <div class="blog-post-info">
                    <div class="author align-items-center mb-1">
                        @if (Model.Guide != null)
                        {
                            <a href="#">@Model.Guide.Name</a>
                        }
                        else
                        {
                            <a href="#">Rehber Atanmadı</a>
                        }
                        <br />
                        <small>@Model.Guide.Description</small>
                    </div>
                    <ul class="blog-meta">
                        <li class="meta-item blog-lesson">
                            <span class="meta-value">@Model.Date.ToString("dd-MMM-yyyy") </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <section class="blog-post-main w3l-homeblock1">
        <div class="blog-content-inf pb-5">
            <div class="container pb-lg-4">
                <div class="single-post-image">
                    <div class="post-content">
                        <img src="@Model.Image" class="img-fluid mb-5" alt="" style="width:100%; border-radius:10px;" />
                    </div>
                </div>

                <div class="single-post-content">
                    <p class="alphabet mb-4">@Model.Details1</p>

                    <blockquote class="blockquote my-5">
                        <div class="icon-quote"><span class="fa fa-quote-left" aria-hidden="true"></span></div>
                        Gezmek, sadece yer görmek değil, hayata yeni bir bakış açısı kazanmaktır.
                        <footer class="blockquote-footer mt-3">Traversal Rehber</footer>
                    </blockquote>

                    <div class="sing-post-thumb mb-5 row pt-3">
                        <div class="col-sm-6">
                            <img src="@Model.CoverImage" class="img-fluid" alt="Görsel 1" style="border-radius:10px; height:300px; width:100%; object-fit:cover;">
                        </div>
                        <div class="col-sm-6 mt-sm-0 mt-3">
                            <img src="@Model.Image2" class="img-fluid" alt="Görsel 2" style="border-radius:10px; height:300px; width:100%; object-fit:cover;">
                        </div>
                    </div>

                    <h3 class="blog-desc-big m-0 mb-lg-4 mb-3">Turun Öne Çıkan Özellikleri</h3>
                    <p class="mb-4">@Model.Details2</p>

                    @* Rehber Detay Kartı *@
                    @await Component.InvokeAsync("GuideDetails", new { id = Model.GuideId })

                    @* Yorum Listesi - Herkese Açık *@
                    @await Component.InvokeAsync("CommentList", new { id = Model.DestinationId })

                    @* Yorum Yapma Paneli - Üye Kontrolü *@
                    <div class="leave-comment-form mt-5" id="reply">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @await Html.PartialAsync("/Views/Comment/AddComment.cshtml", new { id = Model.DestinationId })
                        }
                        else
                        {
                            <div class="alert alert-light text-center py-5 border shadow-sm">
                                <i class="fa fa-lock mb-3 text-warning" style="font-size: 2rem;"></i>
                                <h5 class="text-secondary">Yorum yapabilmek için üye olmanız gereklidir.</h5>
                                <a href="/Login/SignIn/" class="btn btn-style btn-primary mt-3">Hemen Giriş Yap</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>