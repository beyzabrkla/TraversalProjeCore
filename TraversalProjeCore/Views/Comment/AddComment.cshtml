@if (User.Identity.IsAuthenticated)
{
    <div class="leave-comment-form mt-5" id="reply">
        <h4 class="side-title mb-2">Yorum Bırakın</h4>
        <p class="mb-4">* İşaretli alanları doldurmanız gerekmektedir.</p>

        <form method="post" asp-action="AddComment" asp-controller="Comment" id="commentForm">
            <input type="hidden" name="DestinationId" value="@ViewBag.destID" />

            <div class="form-group">
                <textarea name="CommentContent" id="commentContent" class="form-control"
                      placeholder="Yorumunuz*" required="" spellcheck="false"></textarea>
            </div>
            <div class="submit text-right">
                <button type="submit" class="btn btn-style btn-primary">Yorum Yap</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="alert alert-warning mt-5">
        <h4>Yorum yapabilmek için üye olmanız gereklidir.</h4>
        <a href="/Login/SignIn/" class="btn btn-primary btn-sm mt-2">Giriş Yap</a>
    </div>
}

<script>
    document.getElementById("commentForm")?.addEventListener("submit", function(e) {
        const content = document.getElementById("commentContent").value.trim();
        if (!content) {
            alert("Lütfen bir yorum yazın!");
            e.preventDefault();
        }
    });
</script>